# Скопировать на сервер в /home/deploy/rare-leads/.env (chmod 600).
# В git реальные значения не кладём.

PORT=8791
LEADS_LOG=/home/deploy/rare-leads/leads.jsonl
# с каких сайтов принимаем заявки (через запятую)
ALLOWED_ORIGINS=https://rare-anapa.ru,https://www.rare-anapa.ru,https://rare.a-4-to.ru

# Почта: куда и через какой ящик отправлять.
# Для Яндекса нужен «пароль приложения» (id.yandex.ru → Безопасность → Пароли приложений → Почта).
MAIL_TO=mindal.anapa@yandex.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Клиентикс: Настройки → API
KLIENTIKS_ACCOUNT_ID=
KLIENTIKS_USER_ID=
KLIENTIKS_TOKEN=
KLIENTIKS_SOURCE="Сайт rare-anapa.ru"
# кому в Клиентиксе падает задача по заявке (id сотрудника); пусто — без исполнителя, задачу видят все
KLIENTIKS_TASK_EXECUTOR=
